{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rillday-demo",
  "compatibility_date": "2026-10-23",
  "workers_dev": false,
  "routes": [{ "pattern": "rillday-demo.retn0.dev", "custom_domain": true }],
  "assets": { "directory": "./dist", "not_found_handling": "single-page-application" },
